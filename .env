# ============================================
# CRM Backend 开发环境配置
# ============================================
# 开发环境配置文件
# 注意：此文件包含敏感信息，不要提交到版本控制系统

# ============================================
# 数据库配置 (MySQL)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=crm_db1

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT 认证配置
# ============================================
# JWT密钥（开发环境）
JWT_SECRET=ea7b28b74fb8d63de14933378b4d27acb7f2d16e423a3ed3c5f44cc80535069fe767c036c4800bd05227e9627f4a84fe4ea74db6a860fc7baf3fb5ff1f3e9f70
# JWT过期时间
JWT_EXPIRES_IN=7d

# ============================================
# 应用配置
# ============================================
# 应用运行端口
PORT=3000
# 运行环境
NODE_ENV=development

# 天眼查
